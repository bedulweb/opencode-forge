{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "jsx": "react-jsx",
    "types": [
      "@cloudflare/workers-types",
      "vite/client"
    ],
    "baseUrl": ".",
    "paths": {
      "@/*": [
        "./src/client/*"
      ]
    },
    "exactOptionalPropertyTypes": false
  },
  "include": [
    "src",
    "vite.config.ts"
  ]
}
